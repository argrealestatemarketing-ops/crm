{
  "name": "crm-monorepo",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate --filter=@crm/db",
    "db:push": "turbo run db:push --filter=@crm/db",
    "db:migrate": "turbo run db:migrate --filter=@crm/db"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pnpm": "^11.5.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
